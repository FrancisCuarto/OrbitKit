{
  "name": "@francisiv/orbitkit",
  "version": "0.6.1",
  "description": "OrbitKit CLI - Interactive Web GUI Dashboard, TUI & CLI to keep your Godot 4 and Blender projects updated with AI Skills, Addons and MCPs",
  "bin": {
    "orbitkit": "bin/devdock.js",
    "devdock": "bin/devdock.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FrancisCuarto/OrbitKit.git",
    "directory": "packages/cli"
  },
  "keywords": [
    "godot",
    "godot4",
    "gdscript",
    "ai-skills",
    "mcp",
    "model-context-protocol",
    "orbitkit",
    "devdock"
  ],
  "author": "francisiv",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "postinstall": "node bin/postinstall.js"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "commander": "^13.1.0",
    "ora": "^8.2.0",
    "picocolors": "^1.1.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/node": "^22.13.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
