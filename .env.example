# DevDock Environment Configuration Example
# Copy to .env and configure values before starting the application.

# Server Configuration
PORT=4000
NODE_ENV=development
API_BASE_URL=http://localhost:4000

# Client Configuration
CLIENT_ORIGIN=http://localhost:5173

# Database Configuration (MongoDB)
MONGODB_URI=mongodb://localhost:27017/devdock

# Security & Authentication
# Generate strong 64-byte random keys in production
SESSION_SECRET=devdock_super_secret_development_key_change_in_production
JWT_SECRET=devdock_jwt_secret_development_key_change_in_production
JWT_EXPIRES_IN=1h

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000 # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100

# Storage / Artifact Distribution (Optional / S3 compatible)
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./uploads
