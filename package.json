{
  "name": "vgskillframe-monorepo",
  "version": "0.7.0",
  "private": true,
  "description": "VGSkillFrame (Videogame Skill Frame) — Interactive Web GUI, CLI, AI Skills, Model Context Protocol (MCP) Servers & Package Manager for Godot 4 and Blender 3D Developers",
  "homepage": "https://vgskillframe.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FrancisCuarto/OrbitKit.git"
  },
  "keywords": [
    "vgskillframe",
    "videogame-skill-frame",
    "godot",
    "godot4",
    "godot-engine",
    "gdscript",
    "blender",
    "blender-3d",
    "ai-skills",
    "mcp",
    "model-context-protocol",
    "claude-code",
    "cursor",
    "windsurf",
    "context7",
    "gamedev",
    "game-development",
    "godot-addon",
    "godot-plugin",
    "orbitkit",
    "devdock"
  ],
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "build": "pnpm -r --filter=!godot-plugin run build && cp -r apps/web/dist ./dist || true",
    "build:catalog": "node scripts/build-catalog.mjs",
    "dev:api": "pnpm --filter=@devdock/api run dev",
    "dev:web": "pnpm --filter=@devdock/web run dev",
    "lint": "pnpm -r run lint",
    "test": "pnpm -r run test"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
